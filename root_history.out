    1  clear
    2  groupadd students
    3  useradd -m -u 1234 -g students -s /bin/bash user1
    4  passwd user1
    5  chage -M 90 user1
    6  id user1
    7  chage -l user1
    8  find / -type f -perm -4000 -exec ls -l {} \; 2>/dev/null
    9  ps -eo pid,ruid,ruser,euid,euser,comm | awk 'NR==1 || ($4==0 && $2>=1000)'
   10  cp /bin/cat /home/user1/mycat
   11  chown root:root /home/user1/mycat
   12  chmod 4755 /home/user1/mycat
   13  ls -l /home/user1/mycat
   14  apt install libcap2-bin
   15  dnf install libcap2-bin
   16  dnf install -y libcap
   17  cp /bin/chown /home/user1/mychown
   18  setcap cap_chown+ep /home/user1/mychown
   19  getcap /home/user1/mychown
   20  echo 'user1 ALL=(root) /usr/bin/date, /usr/bin/timedatectl' > /etc/sudoers.d/user1
   21  chmod 440 /etc/sudoers.d/user1
   22  visudo -cf /etc/sudoers.d/user1
   23  echo 374781
   24  history > ~/root_history.out
